# Ollama Server Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FILE=logs/graphrag.log
LOG_FORMAT=text
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Document Processing & Ingestion (Phase 2)
DATA_DIR=data
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed
MAX_UPLOAD_SIZE_MB=25
DEFAULT_CHUNK_SIZE=400
DEFAULT_CHUNK_OVERLAP=60

# Vector Database & Retrieval (Phase 3)
CHROMA_PATH=data/chroma
CHROMA_COLLECTION_NAME=graphrag_documents
EMBEDDING_BATCH_SIZE=32
RETRIEVAL_TOP_K=5

# Application Runtime Configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8501
AUTH_MODE=none
REQUEST_TIMEOUT=60

# Knowledge Graph Construction Engine (Phase 4)
GRAPH_DIR=data/knowledge_graph
GRAPH_PATH=data/knowledge_graph/knowledge_graph.json
GRAPH_EXPORT_PATH=data/knowledge_graph/knowledge_graph.graphml
GRAPH_MANIFEST_PATH=data/knowledge_graph/manifest.json
GRAPH_EXTRACTIONS_PATH=data/knowledge_graph/extractions.jsonl
GRAPH_EXTRACTION_MODEL=qwen3:8b
GRAPH_EXTRACTION_TIMEOUT=600
GRAPH_MIN_CONFIDENCE=0.50
GRAPH_AUTO_REBUILD=false

# Graph Retrieval & Multi-Hop Reasoning (Phase 5)
GRAPH_MAX_HOPS=2
GRAPH_MAX_RESULTS=10
GRAPH_MAX_PATHS=50
GRAPH_TRAVERSAL_DIRECTION=both
GRAPH_MAX_DEGREE=50

# Hybrid Retrieval & Reciprocal Rank Fusion (Phase 6)
HYBRID_TOP_K=10
HYBRID_VECTOR_TOP_K=10
HYBRID_GRAPH_TOP_K=10
HYBRID_RRF_K=60
HYBRID_VECTOR_WEIGHT=1.0
HYBRID_GRAPH_WEIGHT=1.0
HYBRID_MIN_RRF_SCORE=0.0
HYBRID_PARALLEL_RETRIEVAL=false

# Grounded Answer Generation & QA (Phase 7)
RAG_GENERATION_MODEL=qwen3:8b
RAG_TEMPERATURE=0.1
RAG_TOP_K=5
RAG_MAX_CONTEXT_TOKENS=3000
RAG_MAX_GENERATION_TOKENS=1024
RAG_GENERATION_TIMEOUT=180
RAG_MIN_EVIDENCE_ITEMS=1
RAG_REQUIRE_CITATIONS=true
RAG_ENABLE_FAITHFULNESS_CHECK=true
RAG_MIN_RELEVANCE_SCORE=0.50

# Comparative Benchmark & Evaluation (Phase 8)
BENCHMARK_DIR=data/phase8_benchmark

# Backup & Operational Persistence (Phase 9)
BACKUP_DIR=data/backups
MAX_CONCURRENT_GENERATIONS=2
MAX_CONCURRENT_BENCHMARKS=1
ENABLE_TELEMETRY=true
