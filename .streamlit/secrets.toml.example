# Graph RAG Benchmark — Streamlit Native OIDC Authentication Secrets Template
#
# INSTRUCTIONS:
# 1. Copy this file to '.streamlit/secrets.toml'
# 2. Fill in the parameters obtained from your chosen OpenID Connect (OIDC) provider.
# 3. NEVER commit 'secrets.toml' to version control (it is strictly excluded in .gitignore and .dockerignore).
# 4. Generate a strong, random 32+ character string for 'cookie_secret'.
#
# IMPORTANT:
# - redirect_uri must exactly match the authorized redirect URI registered with your IdP.
# - For local development: "http://localhost:8501/oauth2callback"
# - For production with TLS reverse proxy: "https://your-domain.com/oauth2callback"
# - server_metadata_url must point to the OpenID discovery document:
#     * Google: "https://accounts.google.com/.well-known/openid-configuration"
#     * Microsoft Entra ID: "https://login.microsoftonline.com/{tenant_id}/v2.0/.well-known/openid-configuration"
#     * Okta: "https://{yourOktaDomain}.okta.com/.well-known/openid-configuration"
#     * Auth0: "https://{yourAuth0Domain}.auth0.com/.well-known/openid-configuration"

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_STRING_32_CHARS"
client_id = "YOUR_OIDC_CLIENT_ID"
client_secret = "YOUR_OIDC_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
